# ═══════════════════════════════════════════════════════════════════
# GeoLens – Environment Variables for Netlify & Serverless Proxy
# Add these variables under: Netlify Site Settings > Build & deploy > Environment
# ═══════════════════════════════════════════════════════════════════

# Copernicus Sentinel Hub Credentials
SENTINEL_CLIENT_ID=your_sentinel_hub_client_id_here
SENTINEL_CLIENT_SECRET=your_sentinel_hub_client_secret_here
SENTINEL_INSTANCE_ID=your_sentinel_hub_instance_id_here

# Open-Meteo Configuration (Standard tier is free and requires no key)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
